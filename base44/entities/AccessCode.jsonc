{
  "name": "AccessCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The secret access code string customers enter"
    },
    "label": {
      "type": "string",
      "description": "Friendly label for the owner to identify this code"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code stops being valid (optional)"
    },
    "max_uses": {
      "type": "number",
      "default": 0,
      "description": "0 = unlimited"
    },
    "uses": {
      "type": "number",
      "default": 0,
      "description": "How many times this code has been used to log in"
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}