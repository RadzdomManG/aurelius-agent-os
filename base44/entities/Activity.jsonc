{
  "name": "Activity",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "e.g. lead_discovered, email_sent, task_created, approval_requested, job_found, memory_stored"
    },
    "description": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "enum": [
        "aurelius",
        "user",
        "sub_agent",
        "system"
      ],
      "default": "aurelius"
    },
    "sub_agent": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "related_type": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "description"
  ]
}