{
  "name": "Approval",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "What Aurelius plans to do, shown for review"
    },
    "action_type": {
      "type": "string",
      "description": "e.g. email_send, follow_up, job_submit, calendar_change, browser_action"
    },
    "payload": {
      "type": "object",
      "description": "Exact planned action details: recipient, subject, body, etc."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "executed"
      ],
      "default": "pending"
    },
    "task_id": {
      "type": "string"
    },
    "related_type": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "action_type"
  ]
}