{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "e.g. high_quality_lead, client_replied, job_match, interview_request, meeting_soon, important_email, automation_failed, auth_expired, lead_interested, daily_report"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "related_type": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "action_url": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type"
  ]
}