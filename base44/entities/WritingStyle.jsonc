{
  "name": "WritingStyle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "client_professional",
        "casual_client",
        "friend",
        "cold_outreach",
        "job_application",
        "follow_up",
        "sales",
        "support"
      ],
      "default": "client_professional"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tone": {
      "type": "string",
      "description": "e.g. warm, direct, professional, casual"
    },
    "vocabulary": {
      "type": "string"
    },
    "sentence_length": {
      "type": "string",
      "description": "short, medium, varied"
    },
    "greeting": {
      "type": "string"
    },
    "emoji_use": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "moderate",
        "frequent"
      ],
      "default": "minimal"
    },
    "language": {
      "type": "string",
      "description": "e.g. English, Tagalog, Taglish",
      "default": "English"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "label"
  ]
}